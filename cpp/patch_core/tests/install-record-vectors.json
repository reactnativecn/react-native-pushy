{
  "description": "Completion records (cpp/patch_core/install_record.h), shared by Android, iOS and HarmonyOS. Each vector writes `record` as the raw text of <dir>/.pushy-complete (null: no record file) next to a bundle whose content is `var a = 1;` (unless `bundle` is false), then checks IsComplete(dir, `hash` or \"abc\") against `complete`, CheckActivation(dir, hash, grandfathered = `grandfathered`) against `activation` (\"ok\" or a substring of the rejection) and RecordedBundleSha256 against `recorded` (default \"\"). In the record text, @SHA@ is the bundle's SHA-256 (lowercase hex), @SHA_UPPER@ the same in uppercase and @OTHER_SHA@ the digest of other content. `was` records how the platforms disagreed before the logic was shared.",
  "vectors": [
    {
      "name": "legacy empty marker: installed, activates unverified",
      "record": "",
      "complete": true,
      "activation": "ok"
    },
    {
      "name": "schema-1 record with a matching digest",
      "record": "{\"schema\":1,\"versionHash\":\"abc\",\"bundleSha256\":\"@SHA@\",\"artifactSha256\":\"ff\"}",
      "complete": true,
      "activation": "ok",
      "recorded": "@SHA@"
    },
    {
      "name": "digest compare is case-insensitive",
      "record": "{\"schema\":1,\"versionHash\":\"abc\",\"bundleSha256\":\"@SHA_UPPER@\"}",
      "complete": true,
      "activation": "ok",
      "recorded": "@SHA_UPPER@"
    },
    {
      "name": "unknown members are ignored",
      "record": "{\"schema\":1,\"versionHash\":\"abc\",\"bundleSha256\":\"@SHA@\",\"future\":{\"x\":[1,2]}}",
      "complete": true,
      "activation": "ok",
      "recorded": "@SHA@"
    },
    {
      "name": "schema written as 1.0 is the number 1",
      "record": "{\"schema\":1.0,\"versionHash\":\"abc\",\"bundleSha256\":\"@SHA@\"}",
      "complete": true,
      "activation": "ok",
      "recorded": "@SHA@"
    },
    {
      "name": "tampered bundle",
      "record": "{\"schema\":1,\"versionHash\":\"abc\",\"bundleSha256\":\"@OTHER_SHA@\"}",
      "complete": true,
      "activation": "bundle digest mismatch",
      "recorded": "@OTHER_SHA@"
    },
    {
      "name": "no bundleSha256: installed for dedup, never activated",
      "record": "{\"schema\":1,\"versionHash\":\"abc\"}",
      "complete": true,
      "activation": "completion record mismatch"
    },
    {
      "name": "empty bundleSha256",
      "record": "{\"schema\":1,\"versionHash\":\"abc\",\"bundleSha256\":\"\"}",
      "complete": true,
      "activation": "completion record mismatch"
    },
    {
      "name": "null bundleSha256",
      "record": "{\"schema\":1,\"versionHash\":\"abc\",\"bundleSha256\":null}",
      "complete": true,
      "activation": "completion record mismatch"
    },
    {
      "name": "numeric bundleSha256 is not a digest",
      "record": "{\"schema\":1,\"versionHash\":\"abc\",\"bundleSha256\":123}",
      "complete": true,
      "activation": "completion record mismatch",
      "was": "Android's crash-attribution read coerced it to \"123\""
    },
    {
      "name": "only an artifact digest",
      "record": "{\"schema\":1,\"versionHash\":\"abc\",\"artifactSha256\":\"@SHA@\"}",
      "complete": true,
      "activation": "completion record mismatch"
    },
    {
      "name": "record of another version",
      "record": "{\"schema\":1,\"versionHash\":\"def\",\"bundleSha256\":\"@SHA@\"}",
      "complete": false,
      "activation": "completion record mismatch",
      "recorded": "@SHA@",
      "was": "iOS/Harmony switchVersion said \"is incomplete.\""
    },
    {
      "name": "future schema",
      "record": "{\"schema\":2,\"versionHash\":\"abc\",\"bundleSha256\":\"@SHA@\"}",
      "complete": false,
      "activation": "completion record mismatch",
      "recorded": "@SHA@"
    },
    {
      "name": "schema as a string",
      "record": "{\"schema\":\"1\",\"versionHash\":\"abc\",\"bundleSha256\":\"@SHA@\"}",
      "complete": false,
      "activation": "completion record mismatch",
      "recorded": "@SHA@",
      "was": "Android (optInt) accepted it"
    },
    {
      "name": "schema as a boolean",
      "record": "{\"schema\":true,\"versionHash\":\"abc\",\"bundleSha256\":\"@SHA@\"}",
      "complete": false,
      "activation": "completion record mismatch",
      "recorded": "@SHA@",
      "was": "iOS (NSNumber intValue) accepted it"
    },
    {
      "name": "fractional schema",
