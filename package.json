{
  "name": "react-native-update",
  "version": "10.62.0",
  "description": "Hot update (OTA) for React Native with Hermes-optimized diff patches, crash rollback and staged rollout. A CodePush alternative for iOS, Android and HarmonyOS.",
  "main": "src/index",
  "types": "src/index.ts",
  "files": [
    "src",
    "!src/__tests__",
    "android/src",
    "!android/src/test",
    "android/lib",
    "android/jni/*.mk",
    "android/jni/HDiffPatch/LICENSE",
    "android/jni/HDiffPatch/README.md",
    "android/jni/HDiffPatch/decompress_plugin_demo.h",
    "android/jni/HDiffPatch/dirDiffPatch/dir_patch/dir_patch_types.h",
    "android/jni/HDiffPatch/file_for_patch.c",
    "android/jni/HDiffPatch/file_for_patch.h",
    "android/jni/HDiffPatch/libHDiffPatch/HPatch/patch.c",
    "android/jni/HDiffPatch/libHDiffPatch/HPatch/patch.h",
    "android/jni/HDiffPatch/libHDiffPatch/HPatch/patch_private.h",
    "android/jni/HDiffPatch/libHDiffPatch/HPatch/patch_types.h",
    "android/jni/lzma/DOC/lzma-sdk.txt",
    "android/jni/lzma/C/7zTypes.h",
    "android/jni/lzma/C/Compiler.h",
    "android/jni/lzma/C/Precomp.h",
    "android/jni/lzma/C/LzmaDec.c",
    "android/jni/lzma/C/LzmaDec.h",
    "android/jni/lzma/C/Lzma2Dec.c",
    "android/jni/lzma/C/Lzma2Dec.h",
    "android/build.gradle",
    "android/proguard.pro",
    "ios",
    "cpp",
    "!cpp/**/tests",
    "harmony/pushy.har",
    "harmony/hvigor-plugin.ts",
    "harmony/pushy/src",
    "react-native-update.podspec",
    "react-native.config.js",
    "expo-module.config.json",
    "README.md",
    "README-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "bun submodule && bun lint",
    "lint": "biome check src && tsc --noEmit && node scripts/check-harmony-types.js && node scripts/check-native-spec-parity.js && bun scripts/generate-contract.ts --check && node scripts/check-readme-options.js",
    "contract": "bun scripts/generate-contract.ts",
    "lint:harmony": "node scripts/check-harmony-types.js",
    "submodule": "git submodule update --init --recursive",
    "test": "bun test src/__tests__",
    "test:patch-core": "./scripts/test-patch-core.sh",
    "test:flow-core": "./scripts/test-update-flow-core.sh",
    "test:core-flags": "./scripts/test-core-platform-flags.sh",
    "generate:flow-vectors": "bun scripts/generate-flow-vectors.ts",
    "build:harmony-har": "node scripts/build-harmony-har.js",
    "build:harmony-e2e": "bash Example/e2etest/scripts/build-harmony-e2e.sh",
    "build:so": "bun submodule && bash scripts/build-android-so.sh",
    "build:ios-release": "cd Example/e2etest && bun && bunx detox build --configuration ios.sim.release",
    "test:ios-release": "cd Example/e2etest && E2E_PLATFORM=ios bunx detox test --configuration ios.sim.release",
    "build:android-debug": "cd Example/e2etest && bun && bunx detox build --configuration android.emu.debug",
    "build:android-release": "cd Example/e2etest && bun && bunx detox build --configuration android.emu.release",
    "test:android-release": "cd Example/e2etest && E2E_PLATFORM=android bunx detox test --configuration android.emu.release --headless --record-logs all",
    "smoke:android-debug": "cd Example/e2etest && bunx detox test --configuration android.emu.debug --config e2e/smoke/jest.config.js",
    "e2e:ios": "bun build:ios-release && bun test:ios-release",
    "e2e:android": "bun build:android-release && bun test:android-release"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reactnativecn/react-native-update.git"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "update",
    "hot-update",
    "hotfix",
    "ota",
    "over-the-air",
    "codepush",
    "code-push",
    "codepush-alternative",
    "hermes",
    "harmonyos",
    "expo",
    "incremental-update",
    "bsdiff",
    "pushy",
    "cresc"
  ],
  "author": "reactnativecn",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/reactnativecn/react-native-update/issues"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-native": "*"
  },
  "homepage": "https://github.com/reactnativecn/react-native-update#readme",
  "codegenConfig": {
    "name": "RCTPushySpec",
    "type": "modules",
    "jsSrcsDir": "src"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@react-native/typescript-config": "0.85.2",
    "@types/bun": "^1.3.11",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-test-renderer": "19.1.0",
    "react": "19.2.3",
    "react-native": "0.85.2",
    "react-test-renderer": "19.2.3",
    "typescript": "^7.0.2"
  }
}
